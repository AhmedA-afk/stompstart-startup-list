{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "first_release",
        "major_update"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "occurred_on": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "precision": {
              "type": "string",
              "const": "day"
            },
            "value": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            }
          },
          "required": [
            "precision",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "precision": {
              "type": "string",
              "const": "month"
            },
            "value": {
              "type": "string",
              "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])$"
            }
          },
          "required": [
            "precision",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "precision": {
              "type": "string",
              "const": "year"
            },
            "value": {
              "type": "string",
              "pattern": "^\\d{4}$"
            }
          },
          "required": [
            "precision",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "precision": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "precision"
          ],
          "additionalProperties": false
        }
      ]
    },
    "date_basis": {
      "type": "string",
      "enum": [
        "announced",
        "effective"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 2000,
          "format": "uri"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "url",
        "title",
        "locator"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "title",
    "summary",
    "occurred_on",
    "date_basis",
    "source"
  ],
  "additionalProperties": false
}
