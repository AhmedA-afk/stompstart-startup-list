{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "proposal_contract": {
      "type": "string",
      "const": "stompstart.launch-proposal/v1alpha1"
    },
    "startup_slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "launch_id": {
      "type": "string",
      "pattern": "^lch_[0-9a-z]{26}$"
    },
    "startup_id": {
      "type": "string",
      "pattern": "^stp_[0-9a-z]{26}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "first_release",
        "major_update"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "occurred_on": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "precision": {
              "type": "string",
              "const": "day"
            },
            "value": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            }
          },
          "required": [
            "precision",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "precision": {
              "type": "string",
              "const": "month"
            },
            "value": {
              "type": "string",
              "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])$"
            }
          },
          "required": [
            "precision",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "precision": {
              "type": "string",
              "const": "year"
            },
            "value": {
              "type": "string",
              "pattern": "^\\d{4}$"
            }
          },
          "required": [
            "precision",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "precision": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "precision"
          ],
          "additionalProperties": false
        }
      ]
    },
    "date_basis": {
      "type": "string",
      "enum": [
        "announced",
        "available"
      ]
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "source_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source_locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "required": [
    "proposal_contract",
    "startup_slug",
    "launch_id",
    "startup_id",
    "kind",
    "title",
    "summary",
    "occurred_on",
    "date_basis",
    "source_url",
    "source_title",
    "source_locator"
  ],
  "additionalProperties": false
}
